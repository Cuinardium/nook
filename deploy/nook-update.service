[Unit]
Description=nook: pull latest image and reconcile containers
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nook
ExecStart=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# Give the server a moment, then fail the unit (and alert via on-failure) if unhealthy.
ExecStartPost=/bin/sh -c 'sleep 5; curl -fsS --max-time 20 http://127.0.0.1:3000/eve/v1/health'
